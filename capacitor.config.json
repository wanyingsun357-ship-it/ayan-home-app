{
  "appId": "com.entangledforever.home",
  "appName": "家",
  "webDir": "dist",
  "server": {
    "url": "https://entangledforever.com",
    "allowNavigation": [
      "entangledforever.com",
      "*.entangledforever.com"
    ]
  },
  "ios": {
    "contentInset": "never",
    "allowsLinkPreview": false,
    "backgroundColor": "#050607",
    "scrollEnabled": true,
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "Keyboard": {
      "resize": "none"
    },
    "PushNotifications": {
      "presentationOptions": []
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "launchFadeOutDuration": 200,
      "backgroundColor": "#050607"
    },
    "StatusBar": {
      "overlaysWebView": true
    }
  }
}