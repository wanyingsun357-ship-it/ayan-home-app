# 家 · iOS 云编译:GitHub Actions 的 macOS 机器上跑,签名证书用 match 存在本仓库 certs 分支,传 TestFlight
default_platform(:ios)

APP_ID = 'com.entangledforever.home'
PROJECT = 'ios/App/App.xcodeproj'

platform :ios do
  desc '编译并上传 TestFlight'
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_content: ENV.fetch('ASC_KEY_P8'),
      is_key_content_base64: false,
      in_house: false
    )

    # App Store Connect 里建 App 记录 + 注册 Bundle ID(已存在就跳过)
    begin
      # produce 没有 api_key 参数,它自动用上面 app_store_connect_api_key 放进 lane_context 的令牌
      produce(
        app_identifier: APP_ID,
        app_name: ENV.fetch('APP_STORE_NAME', 'Entangled Home'),
        language: 'zh-Hans',
        sku: 'entangled-home-1',
        skip_itc: false
      )
    rescue => e
      UI.important("produce 跳过: #{e.message[0, 200]}")
    end

    setup_ci
    match(
      type: 'appstore',
      api_key: api_key,
      app_identifier: APP_ID,
      git_url: ENV.fetch('MATCH_GIT_URL'),
      git_branch: 'certs',
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV.fetch('GITHUB_TOKEN')}"),
      readonly: false
    )

    team_id = ENV["sigh_#{APP_ID}_appstore_team-id"]
    profile = ENV["sigh_#{APP_ID}_appstore_profile-name"]
    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: 'Apple Distribution',
      profile_name: profile,
      bundle_identifier: APP_ID
    )
    increment_build_number(build_number: ENV.fetch('GITHUB_RUN_NUMBER', '1'), xcodeproj: PROJECT)

    build_app(
      project: PROJECT,
      scheme: 'App',
      configuration: 'Release',
      export_method: 'app-store',
      output_directory: 'build',
      output_name: 'home.ipa',
      xcargs: '-allowProvisioningUpdates'
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: 'build/home.ipa',
      skip_waiting_for_build_processing: true,
      changelog: ENV.fetch('CHANGELOG', '云编译')
    )
  end
end
